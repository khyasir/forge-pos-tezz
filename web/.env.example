# Backend origin used by next.config.js rewrites (server-side only).
API_ORIGIN=http://localhost:8000

# Demo sandbox API key (tz_test_...), used ONLY client-side, ONLY before PIN
# login, to populate the branch/terminal picker and product catalog on the
# /login screen. Switched out for the user's JWT immediately after login.
#
# The key is generated randomly by api/app/seed.py the first time the API
# starts against an empty database, so it cannot be baked into source. After
# starting the API once, fetch it with either:
#   sqlite3 api/tezz.db "select key from api_keys limit 1;"
# or log in as owner/manager and call GET /api/v1/api-keys with that JWT.
# Paste the tz_test_... value below.
NEXT_PUBLIC_DEMO_API_KEY=tz_test_replace_me
