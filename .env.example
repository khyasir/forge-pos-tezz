# Copy to .env and adjust. Used by docker-compose.yml.

# Host port the whole app is reachable on (web proxies /api/* to the api service)
APP_PORT=8120

# --- Postgres (used by the api service in docker-compose) ---
POSTGRES_USER=tezz
POSTGRES_PASSWORD=tezz_dev_password
POSTGRES_DB=tezz
# When running api outside docker-compose with pytest/uvicorn directly, point
# DATABASE_URL at sqlite instead so no Postgres is needed:
# DATABASE_URL=sqlite:///./tezz.db
DATABASE_URL=postgresql+pg8000://tezz:tezz_dev_password@db:5432/tezz

# --- api service ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

FISCAL_PROVIDER=mock
# Fraction of mock fiscal calls that should fail, to exercise retry/offline UI (0.0-1.0)
FISCAL_MOCK_FAIL_RATE=0.0
FBR_SANDBOX_URL=https://esp.fbr.gov.pk:8244/FBR/v1/api/Live/PostData
FBR_POS_ID=
FBR_BEARER_TOKEN=

ERP_PROVIDER=mock
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

POS_FEE_PKR=1.0
SEED_ON_STARTUP=true

# --- web service ---
# Base URL the browser uses to reach the API (no trailing slash, no /api
# suffix -- endpoints are requested as `${NEXT_PUBLIC_API_URL}/api/v1/...`
# and `${NEXT_PUBLIC_API_URL}/health`). In docker-compose leave this empty
# ("") so requests stay same-origin and Next.js rewrites forward them to
# the api container; for `npm run dev` outside docker, point it at the
# api server directly, e.g. http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sandbox API key used only to list branches/terminals on the /login screen
# before a user has signed in. This is the fixed demo key the seed always
# creates (see api/app/seed.py DEMO_API_KEY) -- a real deployment would
# generate its own key via /admin -> API Keys and use that instead.
NEXT_PUBLIC_DEMO_API_KEY=tz_test_tezzdemo0000000000000001
DEFAULT_TAX_AUTHORITY=PRA
